services:
  postgres:
    image: postgres:16-alpine
    container_name: examflow-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-examflow}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-examflow_dev_password}
      POSTGRES_DB: ${POSTGRES_DB:-examflow}
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./database/init:/docker-entrypoint-initdb.d:ro
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-examflow} -d ${POSTGRES_DB:-examflow}"]
      interval: 5s
      timeout: 5s
      retries: 10

volumes:
  postgres_data: