# Server
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Number of reverse proxies in front of the app (0 = none, 1 = one proxy such as Nginx)
TRUST_PROXY=0

# Database
DATABASE_URL=postgresql://examflow:examflow_dev_password@localhost:5432/examflow?schema=public

# CORS: comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Rate limiting (per IP). Kept generous because many students may share one school IP.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# Authentication
# REQUIRED: at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# lax works when the frontend and API share a site. Use none only for cross-site hosting (needs HTTPS).
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
# Students can create their own account. Keep false unless you want open registration.
ALLOW_SELF_REGISTRATION=false

# Frontend base URL, used to build the links inside emails
APP_URL=http://localhost:5173

# Email. Leave SMTP_HOST empty in development: emails are printed in the terminal instead.
# In production SMTP_HOST is required.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=ExamFlow <no-reply@examflow.local>

# Seed (used only by `npm run db:seed`). Choose your own passwords, 12+ characters.
SEED_SUPER_ADMIN_EMAIL=admin@examflow.local
SEED_SUPER_ADMIN_PASSWORD=REPLACE_WITH_YOUR_OWN_PASSWORD
SEED_SAMPLE_DATA=false
SEED_SAMPLE_PASSWORD=